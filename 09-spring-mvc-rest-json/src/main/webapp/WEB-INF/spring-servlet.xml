<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:mvc="http://www.springframework.org/schema/mvc"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
           http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans-4.3.xsd
           http://www.springframework.org/schema/context
           http://www.springframework.org/schema/context/spring-context-4.3.xsd
           http://www.springframework.org/schema/mvc
           http://www.springframework.org/schema/mvc/spring-mvc-4.3.xsd">

    <context:component-scan base-package="catalogo"/>
    <mvc:annotation-driven/>

    <bean id="produtoRepository" class="catalogo.ProdutoRepository"/>

    <bean id="produtoController" class="catalogo.ProdutoController">
        <property name="repository" ref="produtoRepository"/>
    </bean>

    <bean id="initializer" class="catalogo.Initializer">
        <property name="repository" ref="produtoRepository"/>
    </bean>

</beans>
